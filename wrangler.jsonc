{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "claude-training",
  "compatibility_date": "2026-11-01",
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "assets": {
    "directory": "./out",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  }
}
